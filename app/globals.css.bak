@tailwind base;
@tailwind components;
@tailwind utilities;

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

@layer base {
  :root {
    --background: 248 250 252;
    --foreground: 15 23 42;
  }

  * {
    @apply border-gray-200;
  }

  body {
    @apply bg-slate-50 text-slate-900 font-sans antialiased;
  }

  h1, h2, h3, h4, h5, h6 {
    @apply font-semibold tracking-tight;
  }
}

@layer components {
  .simulator-banner {
    @apply bg-amber-50 border-b-2 border-amber-400 px-4 py-2 text-center text-sm font-semibold text-amber-800;
  }

  .nav-link {
    @apply flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all duration-150 text-sm font-medium;
  }

  .nav-link-active {
    @apply bg-primary-50 text-primary-700 font-semibold;
  }

  .nav-link-locked {
    @apply opacity-40 cursor-not-allowed;
  }

  .card {
    @apply bg-white rounded-xl border border-slate-200 shadow-sm;
  }

  .page-title {
    @apply text-2xl font-bold text-slate-900;
  }

  .page-subtitle {
    @apply text-sm text-slate-500 mt-1;
  }
}

@layer utilities {
  .scrollbar-thin {
    scrollbar-width: thin;
  }
}
